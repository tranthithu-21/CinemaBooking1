@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                    ● Tuần 2: SQL Server & Dapper
                </span>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle d-none d-md-inline-block small">
                    Clean Architecture 4 Tầng
                </span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="/admin/showtimes" class="btn btn-sm btn-outline-info text-decoration-none px-3 rounded-pill">
                    <i class="bi bi-gear-fill me-1"></i> Quản Trị
                </a>
                <div class="d-flex align-items-center gap-2 text-white small">
                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                    <span class="fw-semibold">Trần Thị Thu</span>
                </div>
            </div>
        </div>

        <article class="content px-3 px-md-4 py-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Có lỗi xảy ra trong quá trình xử lý.
    <a href="" class="reload text-white fw-bold">Tải lại trang</a>
    <a class="dismiss">🗙</a>
</div>
