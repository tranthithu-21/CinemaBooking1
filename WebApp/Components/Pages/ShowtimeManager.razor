@page "/admin/showtimes"
@rendermode InteractiveServer
@inject CreateShowtimeUseCase CreateShowtimeUseCase
@inject ViewMoviesUseCase ViewMoviesUseCase
@inject IShowtimeRepository ShowtimeRepository
@inject IAuditoriumRepository AuditoriumRepository

<PageTitle>Quản Lý Suất Chiếu — Demo Luật 2 — CineMax VIP</PageTitle>

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
        <div>
            <h2 class="fw-bold text-white mb-1">📅 Quản Lý Lịch Chiếu & Suất Chiếu</h2>
            <p class="text-secondary small mb-0" style="color: #94a3b8 !important;">
                Cài đặt <strong>LUẬT 2 (K1.3)</strong>: Tự tính thời gian kết thúc = <code>Thời lượng + 15 phút dọn phòng</code> & Chặn chồng lấn phòng chiếu
            </p>
        </div>
        <div class="mt-2 mt-md-0">
            <a href="/" class="btn btn-cinema-outline btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
            </a>
        </div>
    </div>

    <!-- Thông báo lỗi / thành công (K1.3 & K3.3) -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-lg border-danger mb-4" 
             style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); color: #fecdd3;" role="alert">
            <i class="bi bi-calendar-x-fill fs-3 me-3 text-danger"></i>
            <div>
                <strong class="d-block text-white mb-1">CẢNH BÁO TRÙNG LỊCH PHÒNG CHIẾU (LUẬT 2 - K1.3):</strong>
                <span>@errorMessage</span>
            </div>
            <button type="button" class="btn-close ms-auto btn-close-white" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-lg border-success mb-4" 
             style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #a7f3d0;" role="alert">
            <i class="bi bi-check-circle-fill fs-3 me-3 text-success"></i>
            <div>
                <strong class="d-block text-white mb-1">THÀNH CÔNG:</strong>
                <span>@successMessage</span>
            </div>
            <button type="button" class="btn-close ms-auto btn-close-white" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Form tạo suất chiếu mới -->
        <div class="col-lg-5">
            <div class="card p-4 shadow-sm">
                <h5 class="fw-bold text-white mb-3 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                    ➕ Tạo Suất Chiếu Mới
                </h5>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-semibold">Chọn phim *</label>
                    <select class="form-select form-select-sm" @bind="selectedMovieId">
                        @if (movies != null)
                        {
                            @foreach (var m in movies)
                            {
                                <option value="@m.MovieId">@m.Title (@m.DurationMinutes phút)</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-semibold">Phòng chiếu *</label>
                    <select class="form-select form-select-sm" @bind="selectedAuditoriumId">
                        @if (auditoriums != null)
                        {
                            @foreach (var a in auditoriums)
                            {
                                <option value="@a.AuditoriumId">@a.Name (@a.TotalSeats ghế)</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-semibold">Thời gian bắt đầu chiếu *</label>
                    <input type="datetime-local" class="form-control form-control-sm" @bind="startTime" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-semibold">Giá vé (VNĐ) *</label>
                    <input type="number" step="5000" class="form-control form-control-sm" @bind="price" />
                </div>

                <!-- Box thông tin thời gian tự động tính -->
                <div class="p-3 rounded-3 mb-4" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(56, 189, 248, 0.25);">
                    <div class="small text-secondary mb-1">
                        ⏱️ <strong>Quy tắc tự động tính (Luật 2):</strong>
                    </div>
                    <div class="small text-white">
                        Giờ kết thúc = Giờ bắt đầu + @(SelectedMovieDuration)p (phim) + 15p (dọn phòng)
                    </div>
                    <div class="small fw-bold mt-1" style="color: #38bdf8;">
                        ➜ Dự kiến kết thúc: @(startTime.AddMinutes(SelectedMovieDuration + 15).ToString("HH:mm dd/MM/yyyy"))
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <button class="btn btn-cinema w-100 py-2 fw-bold" @onclick="CreateShowtimeAsync">
                        <i class="bi bi-save2-fill me-1"></i> Lưu Suất Chiếu Vào SQL Server
                    </button>
                    <button class="btn btn-outline-warning btn-sm py-2 rounded-pill fw-semibold" @onclick="SimulateOverlapConflictAsync">
                        ⚡ Thử Trùng Lịch (Demo Luật 2)
                    </button>
                </div>
            </div>
        </div>

        <!-- Cột phải: Danh sách các suất chiếu hiện có trên SQL Server -->
        <div class="col-lg-7">
            <div class="card p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                    <h5 class="fw-bold text-white mb-0">📋 Lịch Chiếu Đang Có Trong CSDL</h5>
                    <button class="btn btn-cinema-outline btn-sm" @onclick="LoadDataAsync">
                        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                    </button>
                </div>

                @if (showtimes == null)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                        <span class="ms-2 text-muted small">Đang nạp danh sách từ SQL Server...</span>
                    </div>
                }
                else if (!showtimes.Any())
                {
                    <p class="text-muted small fst-italic">Chưa có suất chiếu nào được tạo trong CSDL.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr style="color: #64748b; font-size: 12px; text-transform: uppercase;">
                                    <th>Phim</th>
                                    <th>Phòng</th>
                                    <th>Bắt đầu</th>
                                    <th>Kết thúc (+15p)</th>
                                    <th>Giá vé</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody style="font-size: 13.5px;">
                                @foreach (var st in showtimes)
                                {
                                    <tr>
                                        <td class="fw-bold text-white">@st.Movie?.Title</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">@st.Auditorium?.Name</span></td>
                                        <td class="text-success fw-bold">@st.StartTime.ToString("HH:mm dd/MM")</td>
                                        <td class="text-warning fw-bold">@st.EndTime.ToString("HH:mm dd/MM")</td>
                                        <td style="color: #38bdf8;">@st.Price.ToString("N0") đ</td>
                                        <td>
                                            <a href="/booking/@st.ShowtimeId" class="btn btn-cinema-outline btn-sm py-0 px-2" style="font-size: 12px;">
                                                Đặt vé
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<Movie>? movies;
    private IEnumerable<Auditorium>? auditoriums;
    private IEnumerable<Showtime>? showtimes;

    private int selectedMovieId = 1;
    private int selectedAuditoriumId = 1;
    private DateTime startTime = DateTime.Today.AddHours(14);
    private decimal price = 90000;

    private string? errorMessage;
    private string? successMessage;

    private int SelectedMovieDuration =>
        movies?.FirstOrDefault(m => m.MovieId == selectedMovieId)?.DurationMinutes ?? 120;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        movies = await ViewMoviesUseCase.ExecuteAsync();
        auditoriums = await AuditoriumRepository.GetAllAuditoriumsAsync();
        showtimes = await ShowtimeRepository.GetAllShowtimesAsync();

        if (movies != null && movies.Any() && selectedMovieId == 0)
        {
            selectedMovieId = movies.First().MovieId;
        }
        if (auditoriums != null && auditoriums.Any() && selectedAuditoriumId == 0)
        {
            selectedAuditoriumId = auditoriums.First().AuditoriumId;
        }
    }

    private async Task CreateShowtimeAsync()
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            // Gọi UseCase cài đặt LUẬT 2: Tránh trùng lịch phòng chiếu
            var id = await CreateShowtimeUseCase.ExecuteAsync(selectedMovieId, selectedAuditoriumId, startTime, price);
            successMessage = $"Tạo suất chiếu thành công (Mã #{id})! Suất chiếu đã được lưu an toàn vào SQL Server.";
            await LoadDataAsync();
        }
        catch (CoreBusiness.Exceptions.ShowtimeOverlapException ex)
        {
            // Bắt lỗi vi phạm LUẬT 2 và hiển thị thông báo thân thiện (K1.3 & K3.3)
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi: " + ex.Message;
        }
    }

    private async Task SimulateOverlapConflictAsync()
    {
        if (showtimes == null || !showtimes.Any()) return;

        var existing = showtimes.First();
        selectedMovieId = existing.MovieId;
        selectedAuditoriumId = existing.AuditoriumId;

        // Chọn giờ bắt đầu nằm ngay giữa suất chiếu đã có để kích hoạt lỗi
        startTime = existing.StartTime.AddMinutes(30);

        try
        {
            await CreateShowtimeUseCase.ExecuteAsync(selectedMovieId, selectedAuditoriumId, startTime, price);
        }
        catch (CoreBusiness.Exceptions.ShowtimeOverlapException ex)
        {
            errorMessage = $"[DEMO LUẬT 2 KÍCH HOẠT THÀNH CÔNG] {ex.Message}";
        }
    }
}
