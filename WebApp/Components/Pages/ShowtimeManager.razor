@page "/admin/showtimes"
@rendermode InteractiveServer
@inject CreateShowtimeUseCase CreateShowtimeUseCase
@inject ViewMoviesUseCase ViewMoviesUseCase
@inject IShowtimeRepository ShowtimeRepository
@inject IAuditoriumRepository AuditoriumRepository

<PageTitle>Lịch Chiếu & Quản Lý Phòng — CineMax VIP</PageTitle>

<div>
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid var(--border-light);">
        <div>
            <h2 class="fw-bold text-white mb-1" style="font-size: 26px;">
                Quản Lý Lịch Chiếu Phim
            </h2>
            <p class="text-secondary small mb-0">
                Sắp xếp khung giờ chiếu và phân bổ phòng chiếu tại cụm rạp CineMax
            </p>
        </div>
        <div class="mt-2 mt-md-0">
            <a href="/" class="btn-cinema-outline" style="font-size: 13.5px; padding: 7px 16px;">
                <i class="bi bi-arrow-left"></i>
                <span>Về Trang Chủ</span>
            </a>
        </div>
    </div>

    <!-- Thông báo lỗi khi trùng lịch phòng -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-lg mb-4" 
             style="background: rgba(225, 29, 72, 0.15); border: 1px solid rgba(225, 29, 72, 0.4); color: #fecdd3;" role="alert">
            <i class="bi bi-calendar-x-fill fs-3 me-3 text-danger"></i>
            <div>
                <strong class="d-block text-white mb-1">Xung Đột Lịch Chiếu:</strong>
                <span>@errorMessage</span>
            </div>
            <button type="button" class="btn-close ms-auto btn-close-white" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-lg mb-4" 
             style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #a7f3d0;" role="alert">
            <i class="bi bi-check-circle-fill fs-3 me-3 text-success"></i>
            <div>
                <strong class="d-block text-white mb-1">Thành Công!</strong>
                <span>@successMessage</span>
            </div>
            <button type="button" class="btn-close ms-auto btn-close-white" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Form tạo lịch chiếu mới -->
        <div class="col-lg-5">
            <div class="cinema-card p-4 shadow-sm">
                <h4 class="fw-bold text-white mb-3 pb-2" style="border-bottom: 1px solid var(--border-light); font-size: 18px;">
                    Tạo Lịch Chiếu Mới
                </h4>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-semibold">Chọn phim chiếu *</label>
                    <select class="form-select" @bind="selectedMovieId">
                        @if (movies != null)
                        {
                            @foreach (var m in movies)
                            {
                                <option value="@m.MovieId">@m.Title (@m.DurationMinutes phút)</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-semibold">Phòng chiếu *</label>
                    <select class="form-select" @bind="selectedAuditoriumId">
                        @if (auditoriums != null)
                        {
                            @foreach (var a in auditoriums)
                            {
                                <option value="@a.AuditoriumId">@a.Name (@a.TotalSeats ghế)</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-semibold">Thời gian bắt đầu *</label>
                    <input type="datetime-local" class="form-control" @bind="startTime" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-semibold">Giá vé (VNĐ) *</label>
                    <input type="number" step="5000" class="form-control" @bind="price" />
                </div>

                <!-- Box thông tin thời gian kết thúc tự tính -->
                <div class="p-3 rounded-3 mb-4" style="background: rgba(7, 11, 20, 0.8); border: 1px solid var(--border-light);">
                    <div class="small text-secondary mb-1">
                        ⏱️ <strong>Quy chuẩn giãn cách phòng chiếu:</strong>
                    </div>
                    <div class="small text-white">
                        Thời gian kết thúc = Giờ bắt đầu + @(SelectedMovieDuration)p (phim) + 15p (vệ sinh phòng)
                    </div>
                    <div class="small fw-bold mt-1" style="color: #38bdf8;">
                        ➜ Dự kiến kết thúc: @(startTime.AddMinutes(SelectedMovieDuration + 15).ToString("HH:mm dd/MM/yyyy"))
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <button class="btn-cinema-primary w-100 py-3" @onclick="CreateShowtimeAsync">
                        <i class="bi bi-plus-circle"></i>
                        <span>Lưu Suất Chiếu</span>
                    </button>
                    
                    <button class="btn btn-sm btn-outline-secondary opacity-75 mt-2" @onclick="SimulateOverlapConflictAsync" style="font-size: 11.5px; border-radius: 6px;">
                        <i class="bi bi-clock-history me-1"></i> Thử trùng lịch (Kiểm tra tránh xung đột)
                    </button>
                </div>
            </div>
        </div>

        <!-- Cột phải: Danh sách các suất chiếu hiện có -->
        <div class="col-lg-7">
            <div class="cinema-card p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2" style="border-bottom: 1px solid var(--border-light);">
                    <h4 class="fw-bold text-white mb-0" style="font-size: 18px;">Lịch Chiếu Hiện Tại</h4>
                    <button class="btn-cinema-outline py-1 px-3" style="font-size: 12.5px;" @onclick="LoadDataAsync">
                        <i class="bi bi-arrow-clockwise"></i> Làm mới
                    </button>
                </div>

                @if (showtimes == null)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-danger"></div>
                        <span class="ms-2 text-secondary small">Đang nạp danh sách...</span>
                    </div>
                }
                else if (!showtimes.Any())
                {
                    <p class="text-secondary small fst-italic py-3">Chưa có suất chiếu nào được tạo.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="cinema-table">
                            <thead>
                                <tr>
                                    <th>Phim</th>
                                    <th>Phòng</th>
                                    <th>Giờ Chiếu</th>
                                    <th>Giá Vé</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var st in showtimes)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-white">@st.Movie?.Title</div>
                                            <div class="text-secondary small">Kết thúc: @st.EndTime.ToString("HH:mm") (+15p)</div>
                                        </td>
                                        <td>
                                            <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                                                @st.Auditorium?.Name
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-white fw-bold">@st.StartTime.ToString("HH:mm")</span>
                                            <div class="text-secondary small">@st.StartTime.ToString("dd/MM")</div>
                                        </td>
                                        <td class="fw-bold text-white">@st.Price.ToString("N0") đ</td>
                                        <td class="text-end">
                                            <a href="/booking/@st.ShowtimeId" class="btn-cinema-outline py-1 px-3" style="font-size: 12px;">
                                                Đặt Vé
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<Movie>? movies;
    private IEnumerable<Auditorium>? auditoriums;
    private IEnumerable<Showtime>? showtimes;

    private int selectedMovieId = 1;
    private int selectedAuditoriumId = 1;
    private DateTime startTime = DateTime.Today.AddHours(14);
    private decimal price = 90000;

    private string? errorMessage;
    private string? successMessage;

    private int SelectedMovieDuration =>
        movies?.FirstOrDefault(m => m.MovieId == selectedMovieId)?.DurationMinutes ?? 120;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        movies = await ViewMoviesUseCase.ExecuteAsync();
        auditoriums = await AuditoriumRepository.GetAllAuditoriumsAsync();
        showtimes = await ShowtimeRepository.GetAllShowtimesAsync();

        if (movies != null && movies.Any() && selectedMovieId == 0)
        {
            selectedMovieId = movies.First().MovieId;
        }
        if (auditoriums != null && auditoriums.Any() && selectedAuditoriumId == 0)
        {
            selectedAuditoriumId = auditoriums.First().AuditoriumId;
        }
    }

    private async Task CreateShowtimeAsync()
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            var id = await CreateShowtimeUseCase.ExecuteAsync(selectedMovieId, selectedAuditoriumId, startTime, price);
            successMessage = $"Đã tạo suất chiếu thành công!";
            await LoadDataAsync();
        }
        catch (CoreBusiness.Exceptions.ShowtimeOverlapException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi: " + ex.Message;
        }
    }

    private async Task SimulateOverlapConflictAsync()
    {
        if (showtimes == null || !showtimes.Any()) return;

        var existing = showtimes.First();
        selectedMovieId = existing.MovieId;
        selectedAuditoriumId = existing.AuditoriumId;

        // Cố tình chọn giờ bắt đầu nằm giữa suất chiếu đã có
        startTime = existing.StartTime.AddMinutes(30);

        try
        {
            await CreateShowtimeUseCase.ExecuteAsync(selectedMovieId, selectedAuditoriumId, startTime, price);
        }
        catch (CoreBusiness.Exceptions.ShowtimeOverlapException ex)
        {
            errorMessage = ex.Message;
        }
    }
}
