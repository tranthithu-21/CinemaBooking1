@page "/booking"
@page "/booking/{ShowtimeId:int}"
@rendermode InteractiveServer
@inject GetShowtimeByIdUseCase GetShowtimeByIdUseCase
@inject GetAuditoriumSeatsUseCase GetAuditoriumSeatsUseCase
@inject CreateBookingUseCase CreateBookingUseCase
@inject ViewMoviesUseCase ViewMoviesUseCase
@inject ViewShowtimesByMovieIdUseCase ViewShowtimesByMovieIdUseCase
@inject NavigationManager Navigation

<PageTitle>Đặt vé & Chọn ghế — CineMax VIP</PageTitle>

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
        <div>
            <h2 class="fw-bold text-white mb-1">
                🎟️ Sơ Đồ Ghế & Đặt Vé Trực Tuyến
            </h2>
            <p class="text-secondary small mb-0" style="color: #94a3b8 !important;">
                Xử lý giao dịch an toàn với <strong>IDbTransaction (K2.2)</strong> & Ngăn chặn tranh chấp ghế <strong>(Luật 1 - K1.3)</strong>
            </p>
        </div>
        <div class="mt-2 mt-md-0">
            <a href="/" class="btn btn-cinema-outline btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
            </a>
        </div>
    </div>

    <!-- Thông báo lỗi nghiệp vụ Luật 1 (K1.3 & K3.3) -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-lg border-danger mb-4" 
             style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); color: #fecdd3;" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-danger"></i>
            <div>
                <strong class="d-block text-white mb-1">CẢNH BÁO TRANH CHẤP GHẾ (LUẬT 1 - K1.3):</strong>
                <span>@errorMessage</span>
            </div>
            <button type="button" class="btn-close ms-auto btn-close-white" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-lg border-success mb-4" 
             style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #a7f3d0;" role="alert">
            <i class="bi bi-check-circle-fill fs-3 me-3 text-success"></i>
            <div>
                <strong class="d-block text-white mb-1">GIAO DỊCH THÀNH CÔNG (K2.2 & K2.4):</strong>
                <span>@successMessage</span>
            </div>
            <button type="button" class="btn-close ms-auto btn-close-white" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted small">Đang nạp dữ liệu suất chiếu & sơ đồ ghế từ SQL Server...</p>
        </div>
    }
    else if (currentShowtime == null)
    {
        <div class="alert alert-warning">
            Không tìm thấy thông tin suất chiếu. Vui lòng chọn một suất chiếu khác từ danh sách.
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cột trái: Sơ đồ ghế Cinema -->
            <div class="col-lg-8">
                <div class="card p-4 shadow-sm">
                    <!-- Thông tin phim & phòng chiếu -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                        <div>
                            <span class="badge-genre mb-1 d-inline-block">@currentShowtime.Auditorium?.Name</span>
                            <h4 class="fw-bold text-white mb-1">@currentShowtime.Movie?.Title</h4>
                            <div class="text-muted small">
                                🕒 @currentShowtime.StartTime.ToString("HH:mm") - @currentShowtime.EndTime.ToString("HH:mm") 
                                (@currentShowtime.StartTime.ToString("dd/MM/yyyy"))
                            </div>
                        </div>
                        <div class="text-end mt-2 mt-md-0">
                            <div class="text-muted small">Đơn giá vé:</div>
                            <span class="fs-5 fw-bold" style="color: #38bdf8;">
                                @currentShowtime.Price.ToString("N0") đ
                            </span>
                        </div>
                    </div>

                    <!-- Màn hình chiếu cong với hiệu ứng dạ quang Cyber Cyan -->
                    <div class="cinema-screen-container">
                        <div class="cinema-screen"></div>
                        <div class="cinema-screen-label">MÀN HÌNH CHIẾU (SCREEN)</div>
                    </div>

                    <!-- Chú thích loại ghế -->
                    <div class="d-flex justify-content-center flex-wrap gap-4 my-3 small text-secondary">
                        <div class="d-flex align-items-center gap-2">
                            <span class="seat-btn d-inline-block text-center" style="width: 24px; height: 24px; line-height: 24px; font-size: 10px;"></span>
                            Ghế thường
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="seat-btn seat-vip d-inline-block text-center" style="width: 24px; height: 24px; line-height: 24px; font-size: 10px;"></span>
                            Ghế VIP (Hàng B, C)
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="seat-btn seat-selected d-inline-block text-center" style="width: 24px; height: 24px; line-height: 24px; font-size: 10px;"></span>
                            Đang chọn
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="seat-btn seat-booked d-inline-block text-center" style="width: 24px; height: 24px; line-height: 24px; font-size: 10px;"></span>
                            Đã bán (Khóa)
                        </div>
                    </div>

                    <!-- Lưới sơ đồ ghế (24 ghế: A1-A8, B1-B8, C1-C8) -->
                    <div class="d-flex flex-column gap-2 align-items-center my-4">
                        @foreach (var rowGroup in seatStatusList.GroupBy(s => s.Seat.Row))
                        {
                            <div class="d-flex gap-2 align-items-center">
                                <span class="fw-bold text-muted text-center" style="width: 22px; font-size: 13px;">@rowGroup.Key</span>
                                @foreach (var seatItem in rowGroup.OrderBy(s => s.Seat.Number))
                                {
                                    var isSelected = selectedSeatIds.Contains(seatItem.Seat.SeatId);
                                    var isBooked = seatItem.IsBooked;
                                    var isVip = seatItem.Seat.SeatType == "VIP";

                                    <button type="button"
                                            class="seat-btn @(isBooked ? "seat-booked" : isSelected ? "seat-selected" : isVip ? "seat-vip" : "")"
                                            disabled="@isBooked"
                                            @onclick="() => ToggleSeat(seatItem.Seat.SeatId)"
                                            title="Ghế @seatItem.Seat.SeatNumber (@seatItem.Seat.SeatType)">
                                        @seatItem.Seat.SeatNumber
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Thanh Demo Luật 1 -->
                    <div class="mt-3 pt-3 d-flex flex-wrap justify-content-between align-items-center gap-2" 
                         style="border-top: 1px solid rgba(255,255,255,0.06);">
                        <div class="text-secondary small" style="max-width: 500px;">
                            <i class="bi bi-shield-lock-fill text-warning me-1"></i>
                            <strong>Luật 1:</strong> Một ghế trong một suất chiếu chỉ bán đúng 1 lần (kiểm tra logic + Unique key + IDbTransaction).
                        </div>
                        <button class="btn btn-outline-warning btn-sm fw-semibold rounded-pill px-3" @onclick="SimulateConflictTestAsync">
                            ⚡ Demo Luật 1 (Cố tình đặt trùng)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Form thông tin khách hàng & Xác nhận đặt vé -->
            <div class="col-lg-4">
                <div class="card p-4 shadow-sm">
                    <h5 class="fw-bold text-white mb-3 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                        📋 Thông Tin Đặt Vé
                    </h5>

                    <!-- Tóm tắt ghế đang chọn -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Ghế đã chọn:</label>
                        @if (selectedSeatIds.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var id in selectedSeatIds)
                                {
                                    var seat = seatStatusList.FirstOrDefault(s => s.Seat.SeatId == id)?.Seat;
                                    <span class="badge px-2 py-1" style="background: rgba(56, 189, 248, 0.15); border: 1px solid #38bdf8; color: #38bdf8;">
                                        @seat?.SeatNumber (@seat?.SeatType)
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted fst-italic small">Chưa chọn ghế nào trên sơ đồ</div>
                        }
                    </div>

                    <!-- Tổng tiền -->
                    <div class="p-3 rounded-3 mb-3 d-flex justify-content-between align-items-center" 
                         style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.06);">
                        <span class="fw-semibold text-secondary">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold" style="color: #38bdf8;">
                            @((selectedSeatIds.Count * currentShowtime.Price).ToString("N0")) đ
                        </span>
                    </div>

                    <!-- Form thông tin khách hàng -->
                    <div class="mb-2">
                        <label class="form-label text-secondary small fw-semibold">Họ và tên *</label>
                        <input type="text" class="form-control form-control-sm" @bind="customerName" placeholder="Nguyễn Văn A" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-secondary small fw-semibold">Email *</label>
                        <input type="email" class="form-control form-control-sm" @bind="customerEmail" placeholder="nguyenvana@gmail.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-semibold">Số điện thoại *</label>
                        <input type="tel" class="form-control form-control-sm" @bind="customerPhone" placeholder="0901234567" />
                    </div>

                    <button class="btn btn-cinema w-100 py-2 fs-6 mb-2"
                            disabled="@(isSubmitting || !selectedSeatIds.Any())"
                            @onclick="SubmitBookingAsync">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Đang lưu vào SQL Server...</span>
                        }
                        else
                        {
                            <span>💳 Xác Nhận & Đặt Vé Ngay</span>
                        }
                    </button>

                    <div class="text-center text-muted small" style="font-size: 11px;">
                        <i class="bi bi-lock-fill me-1"></i> Ghi Header (Bookings) & Line (Tickets) trong 1 Transaction (K2.2)
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int? ShowtimeId { get; set; }

    private Showtime? currentShowtime;
    private List<SeatStatusDto> seatStatusList = new();
    private List<int> selectedSeatIds = new();

    private string customerName = "Trần Thị Thu";
    private string customerEmail = "thutran@example.com";
    private string customerPhone = "0912345678";

    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadShowtimeAndSeatsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadShowtimeAndSeatsAsync();
    }

    private async Task LoadShowtimeAndSeatsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var targetShowtimeId = ShowtimeId ?? 1;
            currentShowtime = await GetShowtimeByIdUseCase.ExecuteAsync(targetShowtimeId);

            if (currentShowtime != null)
            {
                seatStatusList = await GetAuditoriumSeatsUseCase.ExecuteAsync(currentShowtime.AuditoriumId, currentShowtime.ShowtimeId);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi tải dữ liệu từ CSDL: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleSeat(int seatId)
    {
        errorMessage = null;
        if (selectedSeatIds.Contains(seatId))
        {
            selectedSeatIds.Remove(seatId);
        }
        else
        {
            selectedSeatIds.Add(seatId);
        }
    }

    private async Task SubmitBookingAsync()
    {
        if (currentShowtime == null || !selectedSeatIds.Any()) return;

        if (string.IsNullOrWhiteSpace(customerName) || string.IsNullOrWhiteSpace(customerPhone))
        {
            errorMessage = "Vui lòng nhập đầy đủ tên và số điện thoại khách hàng.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var booking = new Booking
            {
                ShowtimeId = currentShowtime.ShowtimeId,
                CustomerName = customerName.Trim(),
                CustomerEmail = customerEmail.Trim(),
                CustomerPhone = customerPhone.Trim(),
                BookingTime = DateTime.Now,
                TotalAmount = selectedSeatIds.Count * currentShowtime.Price,
                Status = "Confirmed"
            };

            // Gọi UseCase chứa LUẬT 1 (Tranh chấp ghế) & Transaction K2.2
            var bookingId = await CreateBookingUseCase.ExecuteAsync(booking, selectedSeatIds);

            successMessage = $"Đặt vé thành công! Mã đơn đặt vé của bạn là #{bookingId}. Dữ liệu Header và {selectedSeatIds.Count} vé (Lines) đã được lưu đồng bộ vào SQL Server.";
            selectedSeatIds.Clear();

            // Tải lại sơ đồ ghế
            await LoadShowtimeAndSeatsAsync();
        }
        catch (CoreBusiness.Exceptions.SeatAlreadyBookedException ex)
        {
            // Bắt lỗi vi phạm LUẬT 1 và hiển thị thông báo thân thiện (K1.3 & K3.3)
            errorMessage = ex.Message;
            await LoadShowtimeAndSeatsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Có lỗi xảy ra trong quá trình đặt vé: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SimulateConflictTestAsync()
    {
        if (currentShowtime == null) return;

        var alreadyBookedSeat = seatStatusList.FirstOrDefault(s => s.IsBooked);
        if (alreadyBookedSeat == null)
        {
            var firstSeat = seatStatusList.FirstOrDefault();
            if (firstSeat != null)
            {
                selectedSeatIds = new List<int> { firstSeat.Seat.SeatId };
                await SubmitBookingAsync();
                alreadyBookedSeat = seatStatusList.FirstOrDefault(s => s.IsBooked);
            }
        }

        if (alreadyBookedSeat != null)
        {
            var conflictBooking = new Booking
            {
                ShowtimeId = currentShowtime.ShowtimeId,
                CustomerName = "Khách Hàng B (Tranh chấp)",
                CustomerEmail = "khachb@example.com",
                CustomerPhone = "0987654321",
                BookingTime = DateTime.Now,
                TotalAmount = currentShowtime.Price,
                Status = "Confirmed"
            };

            try
            {
                await CreateBookingUseCase.ExecuteAsync(conflictBooking, new List<int> { alreadyBookedSeat.Seat.SeatId });
            }
            catch (CoreBusiness.Exceptions.SeatAlreadyBookedException ex)
            {
                errorMessage = $"[DEMO LUẬT 1 KÍCH HOẠT THÀNH CÔNG] {ex.Message}";
            }
        }
    }
}
