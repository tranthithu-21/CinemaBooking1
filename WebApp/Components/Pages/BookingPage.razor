@page "/booking"
@page "/booking/{ShowtimeId:int}"
@rendermode InteractiveServer
@inject GetShowtimeByIdUseCase GetShowtimeByIdUseCase
@inject GetAuditoriumSeatsUseCase GetAuditoriumSeatsUseCase
@inject CreateBookingUseCase CreateBookingUseCase
@inject ViewMoviesUseCase ViewMoviesUseCase
@inject ViewShowtimesByMovieIdUseCase ViewShowtimesByMovieIdUseCase
@inject NavigationManager Navigation

<PageTitle>Chọn Ghế & Đặt Vé — CineMax VIP</PageTitle>

<div>
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid var(--border-light);">
        <div>
            <h2 class="fw-bold text-white mb-1" style="font-size: 26px;">
                Chọn Ghế & Đặt Vé Trực Tuyến
            </h2>
            <p class="text-secondary small mb-0">
                Lựa chọn vị trí ghế ngồi yêu thích và hoàn tất thanh toán giữ chỗ nhanh chóng
            </p>
        </div>
        <div class="mt-2 mt-md-0">
            <a href="/" class="btn-cinema-outline" style="font-size: 13.5px; padding: 7px 16px;">
                <i class="bi bi-arrow-left"></i>
                <span>Xem Phim Khác</span>
            </a>
        </div>
    </div>

    <!-- Thông báo lỗi khi ghế đã bị đặt trước -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-lg mb-4" 
             style="background: rgba(225, 29, 72, 0.15); border: 1px solid rgba(225, 29, 72, 0.4); color: #fecdd3;" role="alert">
            <i class="bi bi-exclamation-circle-fill fs-3 me-3 text-danger"></i>
            <div>
                <strong class="d-block text-white mb-1">Thông Báo Đặt Chỗ:</strong>
                <span>@errorMessage</span>
            </div>
            <button type="button" class="btn-close ms-auto btn-close-white" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Thông báo thành công -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-lg mb-4" 
             style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #a7f3d0;" role="alert">
            <i class="bi bi-check-circle-fill fs-3 me-3 text-success"></i>
            <div>
                <strong class="d-block text-white mb-1">Đặt Vé Thành Công!</strong>
                <span>@successMessage</span>
            </div>
            <button type="button" class="btn-close ms-auto btn-close-white" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="mt-2 text-secondary small">Đang tải sơ đồ ghế...</p>
        </div>
    }
    else if (currentShowtime == null)
    {
        <div class="cinema-card p-4 text-center">
            <p class="text-secondary mb-3">Không tìm thấy thông tin suất chiếu đã chọn.</p>
            <a href="/" class="btn-cinema-primary">Quay lại chọn phim</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cột trái: Sơ đồ phòng chiếu và chọn ghế -->
            <div class="col-lg-8">
                <div class="cinema-card p-4 shadow-sm">
                    <!-- Thông tin suất chiếu -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid var(--border-light);">
                        <div>
                            <span class="badge mb-1" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                                @currentShowtime.Auditorium?.Name
                            </span>
                            <h3 class="fw-bold text-white mb-1 fs-4">@currentShowtime.Movie?.Title</h3>
                            <div class="text-secondary small">
                                <i class="bi bi-clock me-1"></i>
                                @currentShowtime.StartTime.ToString("HH:mm") - @currentShowtime.EndTime.ToString("HH:mm") 
                                · Ngày @currentShowtime.StartTime.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="text-end mt-2 mt-md-0">
                            <div class="text-secondary small">Giá vé tiêu chuẩn:</div>
                            <span class="fs-4 fw-bold text-white">
                                @currentShowtime.Price.ToString("N0") đ
                            </span>
                        </div>
                    </div>

                    <!-- Màn hình chiếu cong phát sáng -->
                    <div class="screen-area">
                        <div class="curved-screen"></div>
                        <div class="screen-text">MÀN HÌNH CHIẾU (SCREEN)</div>
                    </div>

                    <!-- Chú thích loại ghế -->
                    <div class="d-flex justify-content-center flex-wrap gap-4 my-4 small text-secondary">
                        <div class="d-flex align-items-center gap-2">
                            <span class="seat" style="width: 24px; height: 24px; font-size: 10px; cursor: default;"></span>
                            <span>Ghế Thường</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="seat seat-vip" style="width: 24px; height: 24px; font-size: 10px; cursor: default;"></span>
                            <span>Ghế VIP (Hàng B, C)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="seat seat-selected" style="width: 24px; height: 24px; font-size: 10px; cursor: default;"></span>
                            <span>Đang Chọn</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="seat seat-booked" style="width: 24px; height: 24px; font-size: 10px; cursor: default;"></span>
                            <span>Đã Bán</span>
                        </div>
                    </div>

                    <!-- Lưới sơ đồ 24 ghế (A1-A8, B1-B8, C1-C8) -->
                    <div class="d-flex flex-column gap-2 align-items-center my-4">
                        @foreach (var rowGroup in seatStatusList.GroupBy(s => s.Seat.Row))
                        {
                            <div class="d-flex gap-2 align-items-center">
                                <span class="fw-bold text-secondary text-center" style="width: 24px; font-size: 13px;">@rowGroup.Key</span>
                                @foreach (var seatItem in rowGroup.OrderBy(s => s.Seat.Number))
                                {
                                    var isSelected = selectedSeatIds.Contains(seatItem.Seat.SeatId);
                                    var isBooked = seatItem.IsBooked;
                                    var isVip = seatItem.Seat.SeatType == "VIP";

                                    <button type="button"
                                            class="seat @(isBooked ? "seat-booked" : isSelected ? "seat-selected" : isVip ? "seat-vip" : "")"
                                            disabled="@isBooked"
                                            @onclick="() => ToggleSeat(seatItem.Seat.SeatId)"
                                            title="Ghế @seatItem.Seat.SeatNumber (@seatItem.Seat.SeatType)">
                                        @seatItem.Seat.SeatNumber
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Nút mô phỏng tranh chấp ghế (Dùng khi báo cáo / vấn đáp) -->
                    <div class="mt-4 pt-3 d-flex justify-content-between align-items-center" style="border-top: 1px solid var(--border-light);">
                        <span class="text-muted small" style="font-size: 12px;">
                            * Mỗi ghế trong suất chiếu chỉ được giữ chỗ duy nhất một lần
                        </span>
                        <button class="btn btn-sm btn-outline-secondary opacity-75" @onclick="SimulateConflictTestAsync" style="font-size: 11.5px; border-radius: 6px;">
                            <i class="bi bi-shield-check me-1"></i> Kiểm tra trùng ghế
                        </button>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thông tin đơn hàng & Đặt vé -->
            <div class="col-lg-4">
                <div class="cinema-card p-4 shadow-sm">
                    <h4 class="fw-bold text-white mb-3 pb-2" style="border-bottom: 1px solid var(--border-light); font-size: 18px;">
                        Thông Tin Đặt Vé
                    </h4>

                    <!-- Danh sách ghế đang chọn -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-semibold">Vị trí ghế đã chọn:</label>
                        @if (selectedSeatIds.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var id in selectedSeatIds)
                                {
                                    var seat = seatStatusList.FirstOrDefault(s => s.Seat.SeatId == id)?.Seat;
                                    <span class="badge px-2 py-1" style="background: rgba(225, 29, 72, 0.2); color: #f43f5e; border: 1px solid rgba(225, 29, 72, 0.4); font-size: 12px;">
                                        Ghế @seat?.SeatNumber (@seat?.SeatType)
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted fst-italic small">Chưa chọn ghế nào trên sơ đồ</div>
                        }
                    </div>

                    <!-- Hộp tổng tiền -->
                    <div class="p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center" 
                         style="background: rgba(7, 11, 20, 0.8); border: 1px solid var(--border-light);">
                        <span class="fw-semibold text-secondary small">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold" style="color: #e11d48;">
                            @((selectedSeatIds.Count * currentShowtime.Price).ToString("N0")) đ
                        </span>
                    </div>

                    <!-- Form nhập thông tin người đặt -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-semibold">Họ và tên khách hàng *</label>
                        <input type="text" class="form-control" @bind="customerName" placeholder="Ví dụ: Trần Thị Thu" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-semibold">Địa chỉ Email *</label>
                        <input type="email" class="form-control" @bind="customerEmail" placeholder="thutran@example.com" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-semibold">Số điện thoại liên hệ *</label>
                        <input type="tel" class="form-control" @bind="customerPhone" placeholder="0901234567" />
                    </div>

                    <button class="btn-cinema-primary w-100 py-3 fs-6"
                            disabled="@(isSubmitting || !selectedSeatIds.Any())"
                            @onclick="SubmitBookingAsync">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Đang xử lý thanh toán...</span>
                        }
                        else
                        {
                            <i class="bi bi-credit-card-2-front"></i>
                            <span>Xác Nhận Đặt Vé Ngay</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int? ShowtimeId { get; set; }

    private Showtime? currentShowtime;
    private List<SeatStatusDto> seatStatusList = new();
    private List<int> selectedSeatIds = new();

    private string customerName = "Trần Thị Thu";
    private string customerEmail = "thutran@example.com";
    private string customerPhone = "0912345678";

    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadShowtimeAndSeatsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadShowtimeAndSeatsAsync();
    }

    private async Task LoadShowtimeAndSeatsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var targetShowtimeId = ShowtimeId ?? 1;
            currentShowtime = await GetShowtimeByIdUseCase.ExecuteAsync(targetShowtimeId);

            if (currentShowtime != null)
            {
                seatStatusList = await GetAuditoriumSeatsUseCase.ExecuteAsync(currentShowtime.AuditoriumId, currentShowtime.ShowtimeId);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi nạp dữ liệu: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleSeat(int seatId)
    {
        errorMessage = null;
        if (selectedSeatIds.Contains(seatId))
        {
            selectedSeatIds.Remove(seatId);
        }
        else
        {
            selectedSeatIds.Add(seatId);
        }
    }

    private async Task SubmitBookingAsync()
    {
        if (currentShowtime == null || !selectedSeatIds.Any()) return;

        if (string.IsNullOrWhiteSpace(customerName) || string.IsNullOrWhiteSpace(customerPhone))
        {
            errorMessage = "Vui lòng nhập đầy đủ tên và số điện thoại khách hàng.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var booking = new Booking
            {
                ShowtimeId = currentShowtime.ShowtimeId,
                CustomerName = customerName.Trim(),
                CustomerEmail = customerEmail.Trim(),
                CustomerPhone = customerPhone.Trim(),
                BookingTime = DateTime.Now,
                TotalAmount = selectedSeatIds.Count * currentShowtime.Price,
                Status = "Confirmed"
            };

            var bookingId = await CreateBookingUseCase.ExecuteAsync(booking, selectedSeatIds);

            successMessage = $"Quý khách đã đặt vé thành công! Mã đơn đặt vé của bạn là #{bookingId}.";
            selectedSeatIds.Clear();

            await LoadShowtimeAndSeatsAsync();
        }
        catch (CoreBusiness.Exceptions.SeatAlreadyBookedException ex)
        {
            errorMessage = ex.Message;
            await LoadShowtimeAndSeatsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Có lỗi xảy ra trong quá trình đặt vé: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SimulateConflictTestAsync()
    {
        if (currentShowtime == null) return;

        var alreadyBookedSeat = seatStatusList.FirstOrDefault(s => s.IsBooked);
        if (alreadyBookedSeat == null)
        {
            var firstSeat = seatStatusList.FirstOrDefault();
            if (firstSeat != null)
            {
                selectedSeatIds = new List<int> { firstSeat.Seat.SeatId };
                await SubmitBookingAsync();
                alreadyBookedSeat = seatStatusList.FirstOrDefault(s => s.IsBooked);
            }
        }

        if (alreadyBookedSeat != null)
        {
            var conflictBooking = new Booking
            {
                ShowtimeId = currentShowtime.ShowtimeId,
                CustomerName = "Khách Hàng Tranh Chấp",
                CustomerEmail = "test@example.com",
                CustomerPhone = "0987654321",
                BookingTime = DateTime.Now,
                TotalAmount = currentShowtime.Price,
                Status = "Confirmed"
            };

            try
            {
                await CreateBookingUseCase.ExecuteAsync(conflictBooking, new List<int> { alreadyBookedSeat.Seat.SeatId });
            }
            catch (CoreBusiness.Exceptions.SeatAlreadyBookedException ex)
            {
                errorMessage = ex.Message;
            }
        }
    }
}
