@page "/"
@inject ViewMoviesUseCase ViewMoviesUseCase

<PageTitle>CineMax — Hệ Thống Rạp Chiếu Phim Cao Cấp</PageTitle>

<div>
    <!-- Hero Cinema Banner -->
    <div class="p-4 p-md-5 mb-5 rounded-4 position-relative overflow-hidden" 
         style="background: linear-gradient(90deg, rgba(7, 11, 20, 0.95) 0%, rgba(7, 11, 20, 0.8) 50%, rgba(7, 11, 20, 0.4) 100%), url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1600&auto=format&fit=crop&q=80') center/cover; border: 1px solid rgba(255, 255, 255, 0.08); min-height: 380px; display: flex; align-items: center;">
        <div class="row align-items-center position-relative w-100" style="z-index: 2;">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(225, 29, 72, 0.15); border: 1px solid rgba(225, 29, 72, 0.4);">
                    <span class="spinner-grow spinner-grow-sm text-danger" role="status" style="width: 8px; height: 8px;"></span>
                    <span class="text-danger small fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">BOM TẤN ĐANG KHỞI CHIẾU</span>
                </div>

                <h1 class="display-4 fw-extrabold text-white mb-3" style="font-weight: 800; letter-spacing: -1px;">
                    Đắm Chìm Trong Thế Giới <br />
                    <span style="color: #e11d48;">Điện Ảnh Đỉnh Cao</span>
                </h1>

                <p class="text-secondary fs-6 mb-4" style="max-width: 580px; color: #cbd5e1 !important; line-height: 1.7;">
                    Tận hưởng những siêu phẩm điện ảnh mới nhất cùng hệ thống âm thanh vòm Dolby Atmos đa chiều và màn hình IMAX Laser siêu nét tại cụm rạp CineMax.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a href="/booking/1" class="btn-cinema-primary">
                        <i class="bi bi-ticket-perforated-fill"></i>
                        <span>Đặt Vé Suất Chiếu Nhanh</span>
                    </a>
                    <a href="/admin/showtimes" class="btn-cinema-outline">
                        <i class="bi bi-calendar2-week"></i>
                        <span>Xem Lịch Chiếu Toàn Rạp</span>
                    </a>
                </div>
            </div>

            <div class="col-lg-5 d-none d-lg-block text-end">
                <div class="d-inline-block text-start p-4 rounded-4" style="background: rgba(14, 20, 36, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); width: 340px;">
                    <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
                        <i class="bi bi-stars fs-3 text-warning"></i>
                        <div>
                            <div class="text-white fw-bold">Trải Nghiệm VIP</div>
                            <div class="text-secondary small">Ghế đôi & VIP bọc da êm ái</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
                        <i class="bi bi-soundwave fs-3 text-info"></i>
                        <div>
                            <div class="text-white fw-bold">Âm Thanh Dolby Atmos</div>
                            <div class="text-secondary small">Âm thanh vòm 360 độ chân thực</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-display fs-3 text-danger"></i>
                        <div>
                            <div class="text-white fw-bold">Màn Chiếu IMAX Laser</div>
                            <div class="text-secondary small">Độ tương phản và độ sáng vượt trội</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section Title & Filter -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1" style="font-size: 26px;">Phim Đang Chiếu Tại Rạp</h2>
            <p class="text-secondary small mb-0">Lựa chọn bộ phim yêu thích và đặt chỗ trực tuyến nhanh chóng</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-cinema-primary py-2 px-3" style="font-size: 13px;">Tất Cả Phim</button>
            <button class="btn btn-sm btn-cinema-outline py-2 px-3" style="font-size: 13px;">Hành Động</button>
            <button class="btn btn-sm btn-cinema-outline py-2 px-3" style="font-size: 13px;">Khoa Học Viễn Tưởng</button>
            <button class="btn btn-sm btn-cinema-outline py-2 px-3" style="font-size: 13px;">Hoạt Hình</button>
        </div>
    </div>

    @if (movies == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="text-secondary small mt-2">Đang nạp danh sách phim...</p>
        </div>
    }
    else if (!movies.Any())
    {
        <div class="alert alert-info border-0 rounded-3">Hiện chưa có phim nào trong lịch khởi chiếu.</div>
    }
    else
    {
        <!-- Movie Cards Grid -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var movie in movies)
            {
                <div class="col">
                    <div class="cinema-card h-100 d-flex flex-column">
                        <!-- Poster Box with Gradient and Rating -->
                        <div class="poster-wrapper">
                            <img src="@movie.PosterUrl" alt="@movie.Title" loading="lazy" />
                            <div class="poster-gradient"></div>
                            
                            <span class="badge-format">
                                2D / IMAX
                            </span>

                            <span class="badge-rating">
                                <i class="bi bi-star-fill"></i> 8.8
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge" style="background: rgba(225, 29, 72, 0.12); color: #f43f5e; border: 1px solid rgba(225, 29, 72, 0.3); font-size: 11.5px; font-weight: 600;">
                                    @movie.Genre
                                </span>
                                <span class="text-secondary small">
                                    <i class="bi bi-clock me-1"></i>@movie.DurationMinutes phút
                                </span>
                            </div>

                            <h3 class="fw-bold text-white mb-2 fs-5" style="letter-spacing: -0.3px;">
                                @movie.Title
                            </h3>

                            <p class="text-secondary small flex-grow-1 mb-4" style="line-height: 1.6; color: #94a3b8 !important;">
                                @movie.Description
                            </p>

                            <!-- Bottom Row: Price & Buy Ticket Button -->
                            <div class="pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-secondary d-block" style="font-size: 11px;">Khởi chiếu từ:</span>
                                    <span class="text-white small fw-bold">@movie.ReleaseDate.ToString("dd/MM/yyyy")</span>
                                </div>

                                <a href="/booking" class="btn-cinema-primary" style="padding: 8px 18px; font-size: 13.5px;">
                                    <i class="bi bi-ticket-perforated"></i>
                                    <span>Mua Vé Ngay</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<Movie>? movies;

    protected override async Task OnInitializedAsync()
    {
        movies = await ViewMoviesUseCase.ExecuteAsync();
    }
}
