@page "/"
@inject ViewMoviesUseCase ViewMoviesUseCase

<PageTitle>CineMax - Hệ Thống Đặt Vé Xem Phim</PageTitle>

<div class="container py-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold text-primary mb-1">🎬 CineMax Booking</h1>
            <p class="text-secondary mb-0">Hệ thống chọn ghế và đặt vé xem phim trực tuyến</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
                ● 4 Tầng Clean Architecture
            </span>
        </div>
    </div>

    <h3 class="fw-bold mb-3">Phim Đang Chiếu</h3>

    @if (movies == null)
    {
        <div class="d-flex align-items-center gap-2 text-secondary py-5">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Đang tải danh sách phim...</span>
        </div>
    }
    else if (!movies.Any())
    {
        <div class="alert alert-info">Hiện chưa có phim nào được khởi chiếu.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var movie in movies)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        <img src="@movie.PosterUrl" class="card-img-top object-fit-cover" alt="@movie.Title" style="height: 240px;" />
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-primary-subtle text-primary mb-2 align-self-start">@movie.Genre</span>
                            <h5 class="card-title fw-bold">@movie.Title</h5>
                            <p class="card-text text-secondary small flex-grow-1">@movie.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <span class="text-muted small">⏱️ @movie.DurationMinutes phút</span>
                                <button class="btn btn-primary btn-sm px-3 rounded-pill">Chọn suất chiếu</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<Movie>? movies;

    protected override async Task OnInitializedAsync()
    {
        movies = await ViewMoviesUseCase.ExecuteAsync();
    }
}
