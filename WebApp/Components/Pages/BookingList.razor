@page "/admin/bookings"
@rendermode InteractiveServer
@inject ViewBookingsUseCase ViewBookingsUseCase

<PageTitle>Danh Sách Đơn Đặt Vé (SQL Server)</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-primary mb-1">📑 Danh Sách Đơn Đặt Vé (SQL Server)</h2>
            <p class="text-muted mb-0">Kiểm tra dữ liệu Header (Bookings) và Line (Tickets) đã lưu thực tế trong CSDL (K2.4)</p>
        </div>
        <div>
            <a href="/" class="btn btn-outline-secondary btn-sm">← Về trang chủ</a>
        </div>
    </div>

    @if (bookings == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang tải danh sách đặt vé từ SQL Server...</p>
        </div>
    }
    else if (!bookings.Any())
    {
        <div class="alert alert-info">
            Chưa có đơn đặt vé nào trong CSDL SQL Server. Hãy vào trang <strong><a href="/booking/1">Đặt vé & Chọn ghế</a></strong> để thực hiện giao dịch thử nghiệm.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Đơn (#)</th>
                            <th>Khách Hàng</th>
                            <th>Liên Hệ</th>
                            <th>Suất Chiếu</th>
                            <th>Thời Gian Đặt</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th>Chi Tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in bookings)
                        {
                            <tr>
                                <td class="fw-bold text-primary">#@b.BookingId</td>
                                <td class="fw-semibold">@b.CustomerName</td>
                                <td class="small text-muted">@b.CustomerPhone<br />@b.CustomerEmail</td>
                                <td>Suất #@b.ShowtimeId</td>
                                <td class="small">@b.BookingTime.ToString("HH:mm dd/MM/yyyy")</td>
                                <td class="fw-bold text-danger">@b.TotalAmount.ToString("N0") VNĐ</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        @b.Status
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => ViewDetailsAsync(b.BookingId)">
                                        Xem vé
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Modal xem chi tiết vé thuộc Booking (Lines) -->
    @if (selectedBooking != null)
    {
        <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow border-0">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Chi Tiết Đơn Đặt Vé #@selectedBooking.BookingId</h5>
                        <button type="button" class="btn-close" @onclick="() => selectedBooking = null"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-1"><strong>Khách hàng:</strong> @selectedBooking.CustomerName</p>
                        <p class="mb-1"><strong>Số điện thoại:</strong> @selectedBooking.CustomerPhone</p>
                        <p class="mb-3"><strong>Tổng thanh toán:</strong> <span class="text-danger fw-bold">@selectedBooking.TotalAmount.ToString("N0") đ</span></p>

                        <h6 class="fw-bold border-bottom pb-1">Danh sách vé (Line Items):</h6>
                        @if (selectedBooking.Tickets.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var ticket in selectedBooking.Tickets)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>Ghế: <strong class="badge bg-primary">@ticket.Seat?.SeatNumber</strong> (Loại: @ticket.Seat?.SeatType)</span>
                                        <span class="fw-bold">@ticket.Price.ToString("N0") đ</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted small">Không tìm thấy chi tiết vé.</p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => selectedBooking = null">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<Booking>? bookings;
    private Booking? selectedBooking;

    protected override async Task OnInitializedAsync()
    {
        bookings = await ViewBookingsUseCase.ExecuteAsync();
    }

    private async Task ViewDetailsAsync(int bookingId)
    {
        selectedBooking = await ViewBookingsUseCase.GetByIdAsync(bookingId);
    }
}
